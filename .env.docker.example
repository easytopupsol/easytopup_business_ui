# Copy to .env before running docker compose. This is a public marketing-only website.
# The host port must be free. Existing EasyTopup production containers stay untouched.
EASYTOPUP_LANDING_BIND_PORT=3050
NEXT_PUBLIC_SITE_URL=https://easytopup.shop
NEXT_PUBLIC_CUSTOMER_URL=https://easytopup.shop/customer
NEXT_PUBLIC_AGENT_URL=https://easytopup.shop/agent
NEXT_PUBLIC_DEALER_URL=https://easytopup.shop/dealer
NEXT_PUBLIC_WHATSAPP_NUMBER=6597835517
# Any NEXT_PUBLIC_* change requires a rebuild: docker compose up -d --build
